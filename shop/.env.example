# Copy to .env in this directory. Read by the shop and its scripts.

# Must match POSTGRES_USER, POSTGRES_PASSWORD and POSTGRES_DB in ../.env
DATABASE_URL=postgres://shop:change-me@localhost:5432/shop

# Embeds each Query. Must be the same model the notebook used.
OPENAI_API_KEY=

# Only needed to import a Library from Steam: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional; these are the defaults.
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# Optional; only for adding blocks from the shadcnblocks registry with the shadcn CLI.
# SHADCNBLOCKS_API_KEY=
