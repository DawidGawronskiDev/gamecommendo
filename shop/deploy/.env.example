# Copy to .env on the server (next to compose.yml) and fill in. Never commit the real file.

# Domain the shop is served on. Its DNS must point at this server.
SITE_DOMAIN=games.example.com

# No domain yet? Serve plain HTTP on the server's IP instead:
#   SITE_DOMAIN=:80
#   SITE_URL=http://<server-ip>

# Set by the deploy workflow on every release; the values here are only a fallback.
SHOP_IMAGE=ghcr.io/OWNER/REPO:latest
MIGRATE_IMAGE=ghcr.io/OWNER/REPO-migrate:latest

POSTGRES_USER=shop
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shop

# openssl rand -base64 32
BETTER_AUTH_SECRET=

OPENAI_API_KEY=
STEAM_API_KEY=
